# Copy to .env.prod on the EC2 instance (NOT committed to git).
# Generate APP_KEY with: docker compose -f docker-compose.prod.yml run --rm laravel php artisan key:generate --show

APP_NAME=Recta2
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://recta.isayama-dev.com

# 日本語サイトなので locale は ja 固定 (バリデーションエラーを日本語表示)。
# config/app.php の既定も ja だが、本番 .env で明示しておく。
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (stays inside the Docker network; never exposed publicly)
DB_DATABASE=recta2
DB_USERNAME=recta2
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM

# Postgres container reads these directly — keep in sync with DB_* above.
POSTGRES_DB=recta2
POSTGRES_USER=recta2
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM

# Cache / queue
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Cookie は HTTPS のみで送出する (本番は必ず true)。
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# LINE (fill in when you have channel credentials)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=https://recta.isayama-dev.com/auth/line/callback

# LINE Messaging API (Webhook 受信・プッシュ通知用)
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# LINE Official Account Manager の chat ID。管理画面の人物詳細→「LINE公式で
# 返信」ディープリンク (https://chat.line.biz/{LINE_OA_CHAT_ID}/chat/{user})
# に使う。本番/DEV で公式アカウントが別なので env 管理。未設定だとリンクが
# 出ず「LINE公式への導線」が機能しないので本番では必ず設定すること。
LINE_OA_CHAT_ID=

# Google Maps (server-side: GeocodingService)
GOOGLE_MAPS_SERVER_KEY=
# Frontend Maps key (build args 経由で焼き込まれる)
VITE_GOOGLE_MAPS_API_KEY=
# LINE 公式アカウント Bot基本ID (@xxx)。build args 経由で焼き込まれる。未設定なら @043uxuen。
VITE_LINE_OFFICIAL_ACCOUNT_ID=@043uxuen

# ── SEO (フロント build 時に焼き込む VITE_*。docker-compose.prod.yml の
#    node.build.args にも渡す必要がある) ──
# 本番ドメインを recta.isayama-dev.com 以外にしたら設定する。canonical / og:url /
# twitter に使われる。未設定なら https://recta.isayama-dev.com にフォールバック。
# VITE_SITE_URL=https://recta.example.com
# dev/staging を本番ドメインと別に立てたとき、dev 側ビルドだけ true にして
# 検索インデックスの重複を防ぐ (全ページ noindex,nofollow)。
# VITE_NOINDEX=false

# SSR loader が内部から API を引くための絶対URL。通常は
# docker-compose.prod.yml の node.environment で http://nginx:80 を設定済み。
# INTERNAL_API_BASE_URL=http://nginx:80

# AWS S3 (media uploads). EC2 は IAM Role 経由なので KEY/SECRET は空のまま。
# bucket と region と prefix だけ設定する。
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_MEDIA_PREFIX=prod/
