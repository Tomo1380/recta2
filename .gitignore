/*.png
/*.jpg
/*.jpeg
/*.webp

# orval inputs are copies of backend/api.json (the real source of truth).
# The generated/ outputs ARE committed (so PR diffs show API changes) but
# the local copy of the spec is just a build artifact.
frontend/orval/api.json
