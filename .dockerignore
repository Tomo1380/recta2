# Dependencies (installed in container)
node_modules
frontend/node_modules
backend/vendor

# Laravel runtime artifacts — テスト実行でコンテナ (root) が作る一時ディレクトリ
# (storage/framework/testing/disks 等) はビルドコンテキストから読めず build を
# 壊す。ログ/キャッシュ実体も image に焼く必要はない (実行時に再生成される)。
backend/storage/framework/testing
backend/storage/framework/cache/data
backend/storage/logs/*.log

# Build output
frontend/build
frontend/.react-router
dist

# Git
.git
.gitignore

# Environment — ルート直下だけでなく backend/.env 等の nested も必ず除外する
# (素の `.env` はルートのみ matcher。`COPY backend/ ./` で backend/.env が
#  本番イメージに焼き込まれるのを防ぐため `**/.env` を併記)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# IDE / Editor
.vscode
.idea
.DS_Store

# Claude / MCP
.claude
.mcp.json

# Legacy root files
src/
public/
index.html

# Test
test-results/
*-test.cjs
*-screenshot.cjs

# Docker (avoid recursion)
docker-compose.yml

# Docs
docs/
README.md
CLAUDE.md
