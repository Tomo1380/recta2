# Dependencies (installed in container)
node_modules
frontend/node_modules
backend/vendor

# Build output
frontend/build
frontend/.react-router
dist

# Git
.git
.gitignore

# Environment — ルート直下だけでなく backend/.env 等の nested も必ず除外する
# (素の `.env` はルートのみ matcher。`COPY backend/ ./` で backend/.env が
#  本番イメージに焼き込まれるのを防ぐため `**/.env` を併記)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# IDE / Editor
.vscode
.idea
.DS_Store

# Claude / MCP
.claude
.mcp.json

# Legacy root files
src/
public/
index.html

# Test
test-results/
*-test.cjs
*-screenshot.cjs

# Docker (avoid recursion)
docker-compose.yml

# Docs
docs/
README.md
CLAUDE.md
