# =============================================================================
# Recta2 — Unified local development env (template)
# =============================================================================
# Copy to .env and fill in the blanks. Single source of truth for:
#   - docker compose          : auto-reads ./.env, expands ${VAR}
#   - laravel / scheduler /…  : injected via env_file in docker-compose.yml
#   - vite (node container)   : loadEnv(mode, '../') in frontend/vite.config.ts
#
# For production env, see .env.prod.example (lives on EC2 only).
# =============================================================================

# --- Docker Compose ----------------------------------------------------------
WEB_PORT=3333
NODE_ENV=development

# --- Database ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=recta2
DB_USERNAME=recta2
DB_PASSWORD=secret

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Laravel app -------------------------------------------------------------
APP_NAME=Recta2
APP_ENV=local
# Generate with: docker compose exec laravel php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3333

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

# --- Mail (dev: log driver) --------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS S3 (media uploads) --------------------------------------------------
# 本番 EC2 では IAM Role 経由で credentials を取るので KEY/SECRET は空。
# ローカル開発では dedicated IAM user の access key を入れる
# (AWS console / `aws iam create-access-key --user-name recta2-dev-media`)。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Object key prefix。ローカルは dev/、本番は prod/ で分けて誤上書きを防ぐ。
AWS_MEDIA_PREFIX=dev/

# --- LINE Login --------------------------------------------------------------
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:3333/api/auth/line/callback

# --- LINE Messaging API ------------------------------------------------------
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# LINE Official Account bot basic ID (@xxx形式)
LINE_OFFICIAL_ACCOUNT_ID=

# --- AI ----------------------------------------------------------------------
# Gemini (Agent mode). Empty GEMINI_MODEL => config default (gemini-3.1-flash-lite).
# Set GEMINI_MODEL=gemini-3.1-flash-lite-preview to roll back to the preview tier.
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI (FT model ID is managed in DB via admin panel).
OPENAI_API_KEY=

# --- Google Maps -------------------------------------------------------------
# Browser-exposed; restrict to your domain via HTTP Referrer in GCP console.
VITE_GOOGLE_MAPS_API_KEY=
# Server-side Geocoding; restrict by IP in GCP console.
GOOGLE_MAPS_SERVER_KEY=

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
# LINE 公式アカウントの Bot基本ID (@xxx)。友だち追加 URL に使う。未設定なら @043uxuen。
VITE_LINE_OFFICIAL_ACCOUNT_ID=@043uxuen
